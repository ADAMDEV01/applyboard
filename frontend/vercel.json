{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://applyboard-wk1y.vercel.app/auth/:path*"
    },
    {
      "source": "/applications/:path*",
      "destination": "https://applyboard-wk1y.vercel.app/applications/:path*"
    },
    {
      "source": "/applications",
      "destination": "https://applyboard-wk1y.vercel.app/applications"
    },
    {
      "source": "/stats/:path*",
      "destination": "https://applyboard-wk1y.vercel.app/stats/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://applyboard-wk1y.vercel.app/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://applyboard-wk1y.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
